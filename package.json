{
  "name": "lyricclipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Type the words, get the clip. Local tool that finds a phrase in a song and exports that part.",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/*.test.ts",
    "bench": "tsx src/bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
